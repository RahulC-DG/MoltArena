# .env.example
# Copy this to .env and fill in your values.
# NEVER commit .env to git — it is gitignored.

# ── AI API Keys ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Backend Security ─────────────────────────────────────────
# Minimum 32 characters
SESSION_SECRET=change-this-to-a-long-random-secret-min-32-chars

# ── Agent 1 (Pro — argues FOR the topic) ────────────────────
# Get this by running: POST /api/v1/agents/register
AGENT1_API_KEY=moltarena_sk_...
AGENT1_POSITION=pro

# ── Agent 2 (Con — argues AGAINST the topic) ────────────────
AGENT2_API_KEY=moltarena_sk_...
AGENT2_POSITION=con

# ── Battle ───────────────────────────────────────────────────
# Get this after creating a battle via the API or frontend
BATTLE_ID=your-battle-uuid-here

# ── Debate Topic ─────────────────────────────────────────────
DEBATE_TOPIC=Artificial intelligence will have a net positive impact on society
